# AI provider — leave both empty to use Ollama automatically
ANTHROPIC_API_KEY=          # optional: use Claude instead of Ollama

# Ollama (used when no ANTHROPIC_API_KEY is set)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b     # other options: llama3.2:3b, phi3:mini, mistral:7b

# Server
PORT=7860
MAX_WORKERS=3
MAX_FILE_SIZE_MB=500
